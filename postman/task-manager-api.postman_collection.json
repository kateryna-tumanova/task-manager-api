{
  "info": {
    "_postman_id": "a34af99b-a6f0-41f6-a01f-59a0010d25cc",
    "name": "Task Manager API",
    "description": "Basic Postman collection for Task Manager API.\n\nRun the requests in order from 01 to 09.  \nThe collection automatically stores userId, projectId, and taskId.\n\nThis collection demonstrates the main task workflow:\n\n1. Create a user\n    \n2. Create a project\n    \n3. Create a task assigned to the user and project\n    \n4. Get all tasks\n    \n5. Get the created task by ID\n    \n6. Update the task\n    \n7. Verify the updated task\n    \n8. Delete the task\n    \n9. Verify that the deleted task returns 404 Not Found",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Create User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if ([200, 201].includes(pm.response.code)) {\r",
              "    const responseData = pm.response.json();\r",
              "    pm.collectionVariables.set(\"userId\", responseData.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate a unique test email to avoid duplicate-email conflicts.\r",
              "const uniqueEmail = `jakub.kowalski.${Date.now()}@example.com`;\r",
              "\r",
              "pm.collectionVariables.set(\"userEmail\", uniqueEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Jakub\",\r\n  \"email\": \"{{userEmail}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
